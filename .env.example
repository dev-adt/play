# ==========================================
# Cấu hình môi trường cho Game Tiến lên miền Bắc online
# Domain triển khai: https://play.edunow.today
# ==========================================

# Môi trường chạy
NODE_ENV=production

# Cổng ứng dụng nội bộ
PORT=3027
HOST=0.0.0.0

# Cổng ánh xạ ra 127.0.0.1 trên VPS (tránh trùng các dịch vụ 30xx khác)
APP_PORT=3027

# Domain chính xác có HTTPS (kiểm tra CORS và WebSocket Origin)
APP_ORIGIN=https://play.edunow.today

# Khóa bí mật ký JWT Session (tự sinh ngẫu nhiên trên terminal VPS bằng: openssl rand -hex 32)
SESSION_SECRET=your_random_secret_32_bytes_here

# ==========================================
# CẤU HÌNH DATABASE MYSQL (aaPanel MySQL 8.0)
# ==========================================
# Thay <db_user>, <db_password>, <db_name> bằng thông tin database bạn tạo trên aaPanel
# 
# 1) Khi chạy qua Docker (kết nối ra MySQL của máy chủ host):
DATABASE_URL=mysql://<db_user>:<db_password>@host.docker.internal:3306/<db_name>
#
# 2) Khi chạy trực tiếp bằng Node.js trên VPS (không qua Docker):
# DATABASE_URL=mysql://<db_user>:<db_password>@127.0.0.1:3306/<db_name>

# Thời gian mỗi lượt đánh (giây) - Mặc định 30 giây
TURN_TIMEOUT_SECONDS=30
