# ==========================================
# Cấu hình môi trường cho Game Tiến lên miền Bắc online
# Domain triển khai: https://play.edunow.today
# ==========================================

# Môi trường chạy (development / production)
NODE_ENV=production

# Cổng ứng dụng nội bộ
PORT=3000
HOST=0.0.0.0

# Cổng app ánh xạ ra 127.0.0.1 trên VPS (để Nginx reverse proxy trỏ tới)
APP_PORT=3000

# Domain chính xác có HTTPS (dùng kiểm tra CORS, Socket Origin và tạo link mời)
APP_ORIGIN=https://play.edunow.today

# Khóa bí mật ký JWT Session (tự tạo chuỗi ngẫu nhiên dài ít nhất 32 ký tự, ví dụ: openssl rand -hex 32)
SESSION_SECRET=thay_the_bang_chuoi_bi_mat_ngau_nhien_rat_dai_2026

# Cấu hình PostgreSQL Database
POSTGRES_USER=tienlen
POSTGRES_PASSWORD=thay_the_bang_mat_khau_database_manh_2026
POSTGRES_DB=tienlen_db

# Chuỗi kết nối Database nội bộ Docker (nếu chạy Docker Compose)
DATABASE_URL=postgres://tienlen:thay_the_bang_mat_khau_database_manh_2026@db:5432/tienlen_db

# Thời gian mỗi lượt đánh (giây) - Mặc định 30 giây
TURN_TIMEOUT_SECONDS=30
