# ==========================================
# Cấu hình môi trường cho Game Tiến lên miền Bắc online
# Domain triển khai: https://play.edunow.today
# ==========================================

# Môi trường chạy
NODE_ENV=production

# Cổng ứng dụng nội bộ
PORT=3027
HOST=0.0.0.0

# Cổng ánh xạ ra 127.0.0.1 trên VPS (tránh trùng các dịch vụ 30xx khác)
APP_PORT=3027

# Domain chính xác có HTTPS (kiểm tra CORS và WebSocket Origin)
APP_ORIGIN=https://play.edunow.today

# Khóa bí mật ký JWT Session (tự sinh ngẫu nhiên: openssl rand -hex 32)
SESSION_SECRET=thay_the_bang_chuoi_bi_mat_ngau_nhien_rat_dai_2026

# ==========================================
# CẤU HÌNH DATABASE MYSQL (aaPanel MySQL 8.0)
# ==========================================
# Tên DB: play_db
# Tên User: play_user
# Mật khẩu: 123456Happy
# 
# 1) Nếu chạy Docker kết nối ra MySQL của VPS:
DATABASE_URL=mysql://play_user:123456Happy@host.docker.internal:3306/play_db
#
# 2) Nếu chạy trực tiếp bằng Node.js trên VPS (không qua Docker):
# DATABASE_URL=mysql://play_user:123456Happy@127.0.0.1:3306/play_db

# Thời gian mỗi lượt đánh (giây) - Mặc định 30 giây
TURN_TIMEOUT_SECONDS=30
